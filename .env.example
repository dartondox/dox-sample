APP_NAME=dox
APP_ENV=development
APP_PORT=3000
APP_KEY=

# HTTP/2 over plain TCP (h2c) on the same port, eg. for gRPC. Off when not set.
# APP_HTTP2=true

# HTTPS without a proxy. Off when not set. The two files are PEM files.
# TLS_CERT=/etc/letsencrypt/live/example.com/fullchain.pem
# TLS_KEY=/etc/letsencrypt/live/example.com/privkey.pem

CACHE_STORE=file
STORAGE_DISK=local

# SQLite needs no setup. The file is created at the first start.
DB_CONNECTION=sqlite
DB_NAME=db/dox.sqlite

# A database url. When it is set, it wins over the DB_* keys.
# DATABASE_URL=postgres://user:pass@localhost:5432/dox

# Postgres or MySQL: set DB_CONNECTION=postgres or mysql and fill these in.
# Also remove the two lines of that driver in pubspec.yaml (hooks: user_defines:):
# its name line and its `skip: true` line.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
